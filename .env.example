# Copy to .env. Keep real credentials out of Git.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=4500
GROQ_MIN_REQUEST_INTERVAL_SECONDS=60
GROQ_REASONING_EFFORT=low
# Groq is used for generation. Set GEMINI_API_KEY to retain semantic vector search;
# without it, retrieval gracefully uses BM25 lexical search.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=5
# Optional alternative provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_DIR=data/knowledge_base
USCIS_SOURCE_URL=https://www.uscis.gov/policy-manual/volume-6-part-f-chapter-2
TOP_K=5
TAVILY_API_KEY=
# Optional neural cross-encoder. Leave blank to use metadata-aware reranking.
RERANKER_MODEL=
# Optional for comparable cost estimates in the model comparison report.
MODEL_INPUT_COST_PER_1M=
MODEL_OUTPUT_COST_PER_1M=
